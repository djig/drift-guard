{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @djignesh21/drift-guard hook --agent claude",
            "timeout": 30,
            "statusMessage": "drift-guard: checking for version drift"
          }
        ]
      }
    ]
  }
}
